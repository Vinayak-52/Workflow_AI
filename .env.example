# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Application Security
SESSION_SECRET=dev-session-secret-change-in-production-workflow-ai-32chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32-byte hex for AES-256

# Google OAuth (Read-Only)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Firebase Configuration (Server Admin SDK)
# Optional in dev: In-memory fallback database will be used if credentials are omitted.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Client Firebase Configuration (Vite env)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_API_URL=http://localhost:5000/api/v1

# LLM API (Server-side only)
# Optional in dev: Mock AI responses with grounded citations will be used if omitted.
GEMINI_API_KEY=your-gemini-or-openai-api-key

# ML Model Service
ML_SERVICE_URL=http://localhost:8000
