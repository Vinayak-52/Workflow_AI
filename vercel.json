{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "ai-workspace/client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__vercel_path=$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api?__vercel_path=uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
